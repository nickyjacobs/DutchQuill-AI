#!/usr/bin/env bash
# dq: de ene ingang naar alle DutchQuill-scripts.
#
# Gebruik vanuit een skill (omgevingsvariabelen van de plugin bestaan niet in Bash, dus inline meegeven):
#   CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA}" "${CLAUDE_PLUGIN_ROOT}/scripts/dq" config toon
#
# Bij het eerste gebruik maakt dq een eigen Python-omgeving in de datamap van de plugin (met uv als dat er is,
# anders met python3 -m venv en pip). Lichte commando's installeren alleen de basis; de rest volgt als het nodig is.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# EVAL_DQ_DATA bestaat alleen in de evals (claude plugin eval): daar is de datamap van de plugin niet beschrijfbaar
# en zet een scaffold-script de omgeving vooraf klaar in de werkmap van de run.
DATA="${EVAL_DQ_DATA:-${CLAUDE_PLUGIN_DATA:-${DUTCHQUILL_DATA:-$ROOT/.dev-data}}}"
case "$DATA" in /*|[A-Za-z]:*) ;; *) DATA="$PWD/$DATA" ;; esac
# Is de datamap niet beschrijfbaar (een sandbox, een alleen-lezen schijf), val dan terug op een tijdelijke map in
# plaats van meteen te stoppen. Een bestaande omgeving in de datamap blijft bruikbaar als die alleen te lezen is.
if ! mkdir -p "$DATA" 2>/dev/null || [ ! -w "$DATA" ]; then
  if [ -x "$DATA/venv/bin/python" ] || [ -x "$DATA/venv/Scripts/python.exe" ]; then
    :
  else
    ALT="${TMPDIR:-/tmp}"
    ALT="${ALT%/}/dutchquill-data-$(id -u 2>/dev/null || echo 0)"
    if mkdir -p "$ALT" 2>/dev/null && [ -w "$ALT" ]; then
      echo "DutchQuill: kan niet schrijven in $DATA; ik gebruik $ALT." >&2
      DATA="$ALT"
    else
      echo "DutchQuill: kan niet schrijven in $DATA of $ALT. Ga verder zonder dq." >&2
      exit 1
    fi
  fi
fi
VENV="$DATA/venv"

# Lichte commando's hebben alleen requirements-basis.txt nodig (ruamel.yaml, seconden). De rest (python-docx,
# reportlab, matplotlib, ...) komt pas als een commando het nodig heeft, of als er een .docx/.pdf/.pptx/.xlsx
# als argument meegaat.
NIVEAU="volledig"
case "${1:-}" in
  config|werkmap|versie|historie|gids|tells|feiten|vak|leesbaarheid|apa-check|apa-bron|diff|--help|-h|help|"") NIVEAU="basis" ;;
esac
for arg in "$@"; do
  case "$arg" in *.docx|*.pdf|*.pptx|*.xlsx) NIVEAU="volledig" ;; esac
done
if [ "$NIVEAU" = "basis" ]; then REQ="$ROOT/requirements-basis.txt"; else REQ="$ROOT/requirements.txt"; fi
MARKER="$VENV/.req-$NIVEAU"

venv_python() {
  if [ -x "$VENV/bin/python" ]; then echo "$VENV/bin/python"; else echo "$VENV/Scripts/python.exe"; fi
}

hash_req() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  else sha256sum "$1" | cut -d' ' -f1; fi
}

WANT="$(hash_req "$REQ")"
HAVE="$(cat "$MARKER" 2>/dev/null || true)"
# Is de volledige set al geïnstalleerd, dan is de basis er ook.
if [ "$NIVEAU" = "basis" ] && [ "$WANT" != "$HAVE" ] && [ -f "$VENV/.req-volledig" ]; then
  HAVE="$WANT"
fi

if [ "$WANT" != "$HAVE" ] || [ ! -x "$(venv_python)" ]; then
  # Vanuit de context van een skill (!`...`) nooit installeren: dat zou het laden van de skill blokkeren.
  if [ -n "${DQ_NIET_INSTALLEREN:-}" ]; then
    echo "DutchQuill is nog niet klaar voor gebruik; het eerste dq-commando installeert de benodigde pakketten."
    exit 0
  fi
  # Mislukte de installatie net (geen internet?), probeer het dan pas na tien minuten opnieuw. Zo blijft een
  # skill die dq een paar keer aanroept niet minutenlang hangen; Claude gaat dan verder zonder de scripts.
  MISLUKT="$DATA/.installatie-mislukt"
  if [ -f "$MISLUKT" ] && [ -n "$(find "$MISLUKT" -mmin -10 2>/dev/null)" ]; then
    echo "DutchQuill: de pakketten konden net niet geïnstalleerd worden (geen internet?). Ga verder zonder dq, of probeer het over tien minuten opnieuw." >&2
    exit 1
  fi
  LOCK="$DATA/.installeren"
  # Een slot van meer dan tien minuten oud is van een afgebroken installatie.
  if [ -d "$LOCK" ] && [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$LOCK" 2>/dev/null || true; fi
  for _ in $(seq 1 180); do
    mkdir "$LOCK" 2>/dev/null && break
    if [ ! -d "$LOCK" ]; then  # geen slot van een ander, dus we mogen hier niet schrijven
      echo "DutchQuill: kan niet schrijven in $DATA, dus de pakketten kunnen niet geïnstalleerd worden. Ga verder zonder dq." >&2
      exit 1
    fi
    sleep 1
  done
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
  HAVE="$(cat "$MARKER" 2>/dev/null || true)"
  if [ "$WANT" != "$HAVE" ]; then
    if [ "$NIVEAU" = "basis" ]; then
      echo "DutchQuill: eenmalige installatie (een paar seconden)..." >&2
    else
      echo "DutchQuill: eenmalige installatie van de documentpakketten (± 1 minuut)..." >&2
    fi
    # Is PyPI niet bereikbaar, stop dan meteen in plaats van minutenlang te wachten. Achter een proxy slaan we deze
    # test over (een directe verbinding mislukt daar altijd); dan houden de korte time-outs hieronder het kort.
    if [ -z "${HTTPS_PROXY:-}${https_proxy:-}${ALL_PROXY:-}${all_proxy:-}" ]; then
      PYTEST_SYS="$(command -v python3 || command -v python || true)"
      if [ -n "$PYTEST_SYS" ] && ! "$PYTEST_SYS" -c "import socket; socket.create_connection(('${DQ_PYPI_HOST:-pypi.org}', 443), timeout=5).close()" 2>/dev/null; then
        date > "$MISLUKT"
        echo "DutchQuill: pypi.org is niet bereikbaar, dus de pakketten kunnen nu niet geïnstalleerd worden. Ga verder zonder dq, of probeer het later opnieuw." >&2
        exit 1
      fi
    fi
    export UV_HTTP_TIMEOUT=15 UV_HTTP_RETRIES=0
    # Harde limiet: een installatie die blijft hangen (stil netwerk) breken we af.
    met_limiet() {
      local max="$1"; shift
      "$@" & local pid=$!
      for _ in $(seq 1 "$max"); do kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }; sleep 1; done
      kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 124
    }
    if [ "$NIVEAU" = "basis" ]; then LIMIET=90; else LIMIET=300; fi
    if [ ! -x "$(venv_python)" ]; then
      if command -v uv >/dev/null 2>&1; then
        met_limiet 60 uv venv --quiet --python ">=3.10" "$VENV" >&2 || {
          date > "$MISLUKT"; echo "DutchQuill: Python-omgeving maken mislukt. Ga verder zonder dq." >&2; exit 1; }
      else
        PYTHON_SYS="$(command -v python3 || command -v python || true)"
        if [ -z "$PYTHON_SYS" ]; then
          echo "DutchQuill: geen Python gevonden. Installeer Python 3.10+ (python.org) of uv (docs.astral.sh/uv)." >&2
          exit 1
        fi
        "$PYTHON_SYS" -m venv "$VENV" >&2
      fi
    fi
    PY="$(venv_python)"
    if command -v uv >/dev/null 2>&1; then
      met_limiet "$LIMIET" uv pip install --quiet --python "$PY" -r "$REQ" >&2 || {
        date > "$MISLUKT"; echo "DutchQuill: installeren mislukt (geen internet?). Probeer het later opnieuw." >&2; exit 1; }
    else
      met_limiet "$LIMIET" "$PY" -m pip install --quiet --disable-pip-version-check --timeout 15 --retries 0 -r "$REQ" >&2 || {
        date > "$MISLUKT"; echo "DutchQuill: installeren mislukt (geen internet?). Probeer het later opnieuw." >&2; exit 1; }
    fi
    echo "$WANT" > "$MARKER"
    rm -f "$MISLUKT"
    echo "DutchQuill: installatie klaar." >&2
  fi
  trap - EXIT
  rmdir "$LOCK" 2>/dev/null || true
fi
PY="$(venv_python)"

export DUTCHQUILL_ROOT="$ROOT"
export DUTCHQUILL_DATA="$DATA"
export PYTHONPATH="$ROOT/scripts${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONIOENCODING="utf-8"
exec "$PY" -m dutchquill "$@"
